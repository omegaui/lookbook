using Gtk 4.0;
using Adw 1;

template $CompositorsPage: Adw.Bin {
  child: ScrolledWindow {
    hscrollbar-policy: never;

    child: Adw.Clamp {
      maximum-size: 1180;
      tightening-threshold: 900;

      child: Box {
        orientation: vertical;
        spacing: 20;
        margin-top: 12;
        margin-bottom: 40;
        margin-start: 16;
        margin-end: 16;
        // What this page's things are, and the mix-up people make about them.
        $IntroBanner intro {}

        Box {
          spacing: 16;

          Box {
            orientation: vertical;
            spacing: 4;
            hexpand: true;

            Label {
              styles [
                "title-1",
              ]

              label: _("Compositors");
              xalign: 0;
            }
          }

          Adw.ToggleGroup kind_toggles {
            styles [
              "round",
            ]

            valign: end;
            active-name: "all";

            Adw.Toggle {
              name: "all";
              label: _("All");
            }

            Adw.Toggle {
              name: "tiling";
              label: _("Tiling");
            }

            Adw.Toggle {
              name: "scrolling";
              label: _("Scrolling");
            }

            Adw.Toggle {
              name: "stacking";
              label: _("Stacking");
            }
          }
        }

        FlowBox compositors_flowbox {
          selection-mode: none;
          homogeneous: true;
          min-children-per-line: 1;
          max-children-per-line: 3;
          column-spacing: 12;
          row-spacing: 12;
          margin-top: 8;
        }

        // Rices: complete setups people share for these compositors.
        Box rices_section {
          orientation: vertical;
          spacing: 16;
          margin-top: 24;
          visible: false;

          Box {
            spacing: 12;

            Box {
              orientation: vertical;
              spacing: 4;
              hexpand: true;

              Label {
                styles [
                  "title-2",
                ]

                label: _("Rices");
                xalign: 0;
              }

              Label {
                styles [
                  "dim-label",
                ]

                label: _(
                  "Complete setups people share: a bar, launcher, lock screen and theme that work together. Pick one, then follow its install guide."
                );
                xalign: 0;
                wrap: true;
              }
            }

            // Filled in code with one toggle per compositor that has rices.
            Adw.ToggleGroup rice_filter {
              styles [
                "round",
              ]

              valign: center;
            }
          }

          FlowBox rices_flowbox {
            selection-mode: none;
            homogeneous: true;
            min-children-per-line: 1;
            max-children-per-line: 3;
            column-spacing: 16;
            row-spacing: 16;
          }

          Label {
            styles [
              "dim-label",
              "caption",
            ]

            label: _("Pictures and clips load live from each rice's own repository, and belong to their authors.");
            xalign: 0;
            wrap: true;
          }
        }

        Label {
          styles [
            "dim-label",
            "caption",
          ]

          label: _(
            "Protocol support comes from wayland-explorer, which lists the globals each compositor offers to apps in the version shown on its page."
          );
          xalign: 0;
          wrap: true;
        }
      };
    };
  };
}
