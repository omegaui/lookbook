using Gtk 4.0;
using Adw 1;

template $DesktopsPage: Adw.Bin {
  child: ScrolledWindow {
    hscrollbar-policy: never;

    child: Adw.Clamp {
      maximum-size: 1180;
      tightening-threshold: 900;

      child: Box {
        orientation: vertical;
        spacing: 24;
        margin-top: 12;
        margin-bottom: 40;
        margin-start: 16;
        margin-end: 16;

        Box {
          orientation: vertical;
          spacing: 4;

          Label {
            styles [
              "title-1",
            ]

            label: _("Desktops");
            xalign: 0;
          }

          Label {
            styles [
              "dim-label",
            ]

            label: _("A desktop environment bundles a compositor, a shell, settings and apps into one experience.");
            xalign: 0;
            wrap: true;
          }
        }

        // Lookbook is a GNOME app first, so GNOME gets the featured spot.
        Box featured_banner {
          styles [
            "spotlight",
            "accent-blue",
          ]

          overflow: hidden;

          Box {
            orientation: vertical;
            spacing: 14;
            valign: center;
            margin-top: 36;
            margin-bottom: 36;
            margin-start: 36;
            margin-end: 8;

            Box {
              spacing: 16;

              $LogoTile featured_tile {
                valign: center;
              }

              Box {
                orientation: vertical;
                spacing: 2;
                valign: center;

                Label {
                  styles [
                    "kicker",
                  ]

                  label: _("Made for GNOME");
                  xalign: 0;
                }

                Label featured_name_label {
                  styles [
                    "hero-title",
                  ]

                  xalign: 0;
                }
              }
            }

            Label {
              styles [
                "hero-subtitle",
              ]

              label: _("Lookbook is a GNOME app first. See what GNOME is made of, which extensions people love, and what you can build on it.");
              use-markup: true;
              xalign: 0;
              wrap: true;
              max-width-chars: 44;
            }

            Box featured_chips_box {
              spacing: 6;
            }

            Box {
              spacing: 10;
              margin-top: 6;

              Button {
                styles [
                  "pill",
                  "suggested-action",
                ]

                label: _("Explore GNOME");
                action-name: "win.show-item";
                action-target: "'desktop:gnome'";
              }

              Button {
                styles [
                  "pill",
                ]

                label: _("What Can I Build?");
                action-name: "win.show-page";
                action-target: "'system'";
              }
            }
          }

          // The drawn scene shows until GNOME's real screenshot arrives.
          Stack featured_art {
            transition-type: crossfade;
            hexpand: true;

            StackPage {
              name: "drawing";

              child: $IsoScene featured_scene {};
            }

            StackPage {
              name: "screenshot";

              child: $IsoPicture featured_picture {};
            }
          }
        }

        Box {
          spacing: 12;
          margin-top: 12;

          Label {
            styles [
              "title-2",
            ]

            label: _("All Desktops");
            xalign: 0;
            hexpand: true;
          }

          // Shows only desktops built with one toolkit family.
          Adw.ToggleGroup toolkit_filter {
            styles [
              "round",
            ]

            active-name: "all";
            notify::active-name => $on_toolkit_changed() swapped;

            Adw.Toggle {
              name: "all";
              label: _("All");
            }

            Adw.Toggle {
              name: "gtk";
              label: _("GTK");
            }

            Adw.Toggle {
              name: "qt";
              label: _("Qt");
            }

            Adw.Toggle {
              name: "rust";
              label: _("Rust");
            }
          }
        }

        FlowBox desktops_flowbox {
          selection-mode: none;
          homogeneous: true;
          min-children-per-line: 1;
          max-children-per-line: 3;
          column-spacing: 16;
          row-spacing: 16;
        }
      };
    };
  };
}
