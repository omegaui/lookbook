using Gtk 4.0;
using Adw 1;

template $ItemDetailPage: Adw.NavigationPage {
  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}

    content: ScrolledWindow {
      hscrollbar-policy: never;

      child: Adw.Clamp {
        maximum-size: 1180;
        tightening-threshold: 900;

        child: Box {
          orientation: vertical;
          spacing: 36;
          margin-top: 12;
          margin-bottom: 40;
          margin-start: 16;
          margin-end: 16;
          // Banner: logo, name and facts, next to a scene drawn in the item's colors.
          Box {
            styles [
              "detail-banner",
            ]

            overflow: hidden;

            Box {
              orientation: vertical;
              spacing: 12;
              valign: center;
              margin-top: 36;
              margin-bottom: 36;
              margin-start: 36;
              margin-end: 8;

              $LogoTile tile {
                halign: start;
              }

              Box {
                spacing: 10;
                margin-top: 6;

                Label name_label {
                  styles [
                    "hero-title",
                  ]

                  xalign: 0;
                  wrap: true;
                }

                Label badge_label {
                  styles [
                    "badge",
                  ]

                  visible: false;
                  valign: center;
                }
              }

              Label tagline_label {
                styles [
                  "hero-subtitle",
                ]

                xalign: 0;
                wrap: true;
                max-width-chars: 40;
              }

              Box chips_box {
                spacing: 6;
              }

              Box {
                spacing: 10;
                margin-top: 6;

                Button {
                  styles [
                    "pill",
                    "suggested-action",
                  ]

                  clicked => $on_website_clicked() swapped;

                  child: Adw.ButtonContent {
                    label: _("Website");
                    icon-name: "adw-external-link-symbolic";
                  };
                }

                Button run_button {
                  styles [
                    "pill",
                  ]

                  label: _("Can I Run It?");
                  action-name: "win.can-i-run";
                }
              }
            }

            // The drawn scene shows until the item's real screenshot arrives.
            Stack banner_art {
              transition-type: crossfade;
              hexpand: true;

              StackPage {
                name: "drawing";

                child: $IsoScene scene {};
              }

              StackPage {
                name: "screenshot";

                child: $IsoPicture banner_picture {};
              }
            }
          }

          // Screenshots first: looks are what people notice before features.
          Box wall_section {
            orientation: vertical;
            spacing: 16;
            visible: false;

            Label {
              styles [
                "title-2",
              ]

              label: _("Hall of Fame");
              xalign: 0;
            }

            Grid wall_grid {
              column-spacing: 12;
              row-spacing: 12;
              column-homogeneous: true;
            }
          }

          Box {
            orientation: vertical;
            spacing: 16;

            Label facts_title_label {
              styles [
                "title-2",
              ]

              xalign: 0;
            }

            FlowBox facts_flowbox {
              selection-mode: none;
              homogeneous: true;
              min-children-per-line: 1;
              max-children-per-line: 4;
              column-spacing: 12;
              row-spacing: 12;
            }
          }

          // Compositors only: rices people share for it.
          Box rices_section {
            orientation: vertical;
            spacing: 16;
            visible: false;

            Box {
              orientation: vertical;
              spacing: 4;

              Label rices_title_label {
                styles [
                  "title-2",
                ]

                xalign: 0;
                wrap: true;
              }

              Label {
                styles [
                  "dim-label",
                ]

                label: _("Complete setups people share. Pick one, then follow its install guide.");
                xalign: 0;
                wrap: true;
              }
            }

            FlowBox rices_flowbox {
              selection-mode: none;
              homogeneous: true;
              min-children-per-line: 1;
              max-children-per-line: 3;
              column-spacing: 16;
              row-spacing: 16;
            }
          }

          // GNOME only: popular extensions, read live from extensions.gnome.org.
          Box extensions_section {
            orientation: vertical;
            spacing: 16;
            visible: false;

            Box {
              orientation: vertical;
              spacing: 4;

              Label {
                styles [
                  "title-2",
                ]

                label: _("Popular Extensions");
                xalign: 0;
              }

              Label {
                styles [
                  "dim-label",
                ]

                label: _("Live from extensions.gnome.org");
                xalign: 0;
              }
            }

            FlowBox extensions_flowbox {
              selection-mode: none;
              homogeneous: true;
              min-children-per-line: 1;
              max-children-per-line: 3;
              column-spacing: 12;
              row-spacing: 16;
            }
          }

          // Desktops and compositors: the ideas this item supports.
          Box ideas_section {
            orientation: vertical;
            spacing: 16;
            visible: false;

            Box {
              orientation: vertical;
              spacing: 4;

              Label ideas_title_label {
                styles [
                  "title-2",
                ]

                xalign: 0;
                wrap: true;
              }

              Label ideas_note_label {
                styles [
                  "dim-label",
                ]

                xalign: 0;
                wrap: true;
              }
            }

            FlowBox ideas_flowbox {
              selection-mode: none;
              homogeneous: true;
              min-children-per-line: 1;
              max-children-per-line: 2;
              column-spacing: 12;
              row-spacing: 12;
            }
          }

          // Versus your system.
          Box versus_section {
            styles [
              "versus-panel",
            ]

            orientation: vertical;
            spacing: 18;
            visible: false;

            Box {
              orientation: vertical;
              spacing: 4;

              Label {
                styles [
                  "kicker",
                ]

                label: _("Versus your system");
                xalign: 0;
              }

              Label versus_title_label {
                styles [
                  "title-2",
                ]

                xalign: 0;
                wrap: true;
              }
            }

            Grid versus_grid {
              column-spacing: 12;
              row-spacing: 8;
              column-homogeneous: true;
            }
          }

          Box similar_section {
            orientation: vertical;
            spacing: 16;
            visible: false;

            Label similar_title_label {
              styles [
                "title-2",
              ]

              xalign: 0;
            }

            FlowBox similar_flowbox {
              selection-mode: none;
              homogeneous: true;
              min-children-per-line: 1;
              max-children-per-line: 3;
              column-spacing: 12;
              row-spacing: 12;
            }
          }

          // Compositors only: what the compositor offers to apps.
          Box protocols_section {
            orientation: vertical;
            spacing: 16;
            visible: false;

            Label {
              styles [
                "title-2",
              ]

              label: _("Wayland Protocols");
              xalign: 0;
            }

            Label protocols_summary_label {
              styles [
                "dim-label",
              ]

              xalign: 0;
              wrap: true;
            }

            Box checks_box {
              spacing: 16;
            }

            FlowBox protocol_cards_flowbox {
              selection-mode: none;
              homogeneous: true;
              min-children-per-line: 1;
              max-children-per-line: 2;
              column-spacing: 12;
              row-spacing: 12;
            }

            Expander more_protocols_expander {
              child: FlowBox more_protocols_flowbox {
                selection-mode: none;
                min-children-per-line: 1;
                max-children-per-line: 6;
                column-spacing: 6;
                row-spacing: 6;
                margin-top: 12;
              };
            }
          }
        };
      };
    };
  };
}
