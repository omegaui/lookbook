using Gtk 4.0;
using Adw 1;

template $SystemPage: Adw.Bin {
  child: ScrolledWindow {
    hscrollbar-policy: never;

    child: Adw.Clamp {
      maximum-size: 1180;
      tightening-threshold: 900;

      child: Box {
        orientation: vertical;
        spacing: 32;
        margin-top: 12;
        margin-bottom: 40;
        margin-start: 16;
        margin-end: 16;
        // Hero: what you run, how many ideas are ready, and the stack it is built from.
        // The question mark explains how distros, desktops and compositors fit together.
        Overlay {
          [overlay]
          Button help_button {
            styles [
              "circular",
              "osd",
            ]

            icon-name: "dialog-question-symbolic";
            tooltip-text: _("What are distros, desktops and compositors?");
            halign: end;
            valign: start;
            margin-top: 16;
            margin-end: 16;
            clicked => $on_help_clicked() swapped;
          }

          child: Box {
            styles [
              "system-hero",
            ]

            overflow: hidden;

            Box {
              orientation: vertical;
              spacing: 14;
              valign: center;
              margin-top: 40;
              margin-bottom: 40;
              margin-start: 40;
              margin-end: 8;

              Label {
                styles [
                  "kicker",
                ]

                label: _("Your system");
                xalign: 0;
              }

              Label title_label {
                styles [
                  "hero-title",
                ]

                xalign: 0;
                wrap: true;
              }

              Label session_label {
                styles [
                  "hero-subtitle",
                ]

                xalign: 0;
                wrap: true;
                max-width-chars: 44;
              }

              Box {
                orientation: vertical;
                spacing: 8;
                margin-top: 8;

                Box {
                  Label {
                    styles [
                      "heading",
                    ]

                    label: _("Ideas you have or can build");
                    xalign: 0;
                    hexpand: true;
                  }

                  Label ready_label {
                    styles [
                      "heading",
                    ]
                  }
                }

                LevelBar ready_bar {
                  max-value: 1;
                }
              }

              Box {
                spacing: 10;
                margin-top: 8;

                Button {
                  styles [
                    "pill",
                    "suggested-action",
                  ]

                  label: _("Scan Again");
                  action-name: "win.scan-again";
                }

                Button copy_button {
                  styles [
                    "pill",
                    "hero-button",
                  ]

                  label: _("Copy Report");
                  clicked => $on_copy_clicked() swapped;
                }
              }
            }

            $LayerStack stack {
              hexpand: true;
            }
          };
        }

        FlowBox facts_flowbox {
          selection-mode: none;
          homogeneous: true;
          min-children-per-line: 1;
          max-children-per-line: 3;
          column-spacing: 12;
          row-spacing: 12;
        }

        // Ideas.
        Box {
          orientation: vertical;
          spacing: 16;

          Box {
            orientation: vertical;
            spacing: 12;

            Box {
              orientation: vertical;
              spacing: 4;
              hexpand: true;

              Label {
                styles [
                  "title-2",
                ]

                label: _("Ideas You Can Build");
                xalign: 0;
              }

              Label ideas_note_label {
                styles [
                  "dim-label",
                ]

                xalign: 0;
                wrap: true;
              }
            }

            Adw.ToggleGroup status_toggles {
              styles [
                "round",
              ]

              halign: start;
              active-name: "all";

              Adw.Toggle {
                name: "all";
                label: _("All");
              }

              Adw.Toggle {
                name: "ready";
                label: _("Ready Here");
              }

              Adw.Toggle {
                name: "elsewhere";
                label: _("Works Elsewhere");
              }
            }
          }

          FlowBox ideas_flowbox {
            selection-mode: none;
            homogeneous: true;
            min-children-per-line: 1;
            max-children-per-line: 2;
            column-spacing: 12;
            row-spacing: 12;
          }

          // Shown when the filter leaves no idea, so the section never looks broken.
          Adw.StatusPage ideas_empty {
            styles [
              "compact",
            ]

            visible: false;
          }
        }

        // Protocols, grouped by job.
        Box {
          orientation: vertical;
          spacing: 16;

          Box {
            orientation: vertical;
            spacing: 4;

            Label {
              styles [
                "title-2",
              ]

              label: _("Wayland Protocols");
              xalign: 0;
            }

            Label protocols_note_label {
              styles [
                "dim-label",
              ]

              xalign: 0;
              wrap: true;
            }
          }

          $ProtocolBrowser protocol_browser {}
        }
      };
    };
  };
}
