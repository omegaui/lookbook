using Gtk 4.0;
using Adw 1;

template $ExplorePage: Adw.Bin {
  child: ScrolledWindow {
    hscrollbar-policy: never;

    child: Adw.Clamp {
      maximum-size: 1180;
      tightening-threshold: 900;

      child: Box {
        orientation: vertical;
        spacing: 40;
        margin-top: 12;
        margin-bottom: 40;
        margin-start: 16;
        margin-end: 16;
        // Hero: a short pitch next to a strip of collection cards that runs off the edge.
        Box {
          styles [
            "hero",
          ]

          homogeneous: false;
          overflow: hidden;

          Box {
            orientation: vertical;
            spacing: 16;
            valign: center;
            margin-top: 48;
            margin-bottom: 48;
            margin-start: 40;
            margin-end: 16;

            Label {
              styles [
                "kicker",
              ]

              label: _("Syspedia");
              xalign: 0;
            }

            Label {
              styles [
                "hero-title",
              ]

              label: _("Find your corner of Linux");
              xalign: 0;
              wrap: true;
            }

            Label {
              styles [
                "dim-label",
                "hero-subtitle",
              ]

              label: _("Browse distros, desktops and compositors, then see what your own system can do.");
              xalign: 0;
              wrap: true;
              max-width-chars: 40;
            }

            Box {
              spacing: 10;
              margin-top: 8;

              Button {
                styles [
                  "pill",
                  "suggested-action",
                ]

                label: _("Check My System");
                action-name: "win.show-page";
                action-target: "'system'";
              }

              Button {
                styles [
                  "pill",
                ]

                label: _("Browse Distros");
                action-name: "win.show-page";
                action-target: "'distros'";
              }
            }
          }

          // Takes the pointer so cards lift on hover. It never scrolls
          // vertically, so the mouse wheel still scrolls the page.
          ScrolledWindow {
            hscrollbar-policy: external;
            vscrollbar-policy: never;
            hexpand: true;

            child: Box collections_box {
              spacing: 20;
              halign: start;
              valign: center;
              margin-top: 40;
              margin-bottom: 40;
              margin-start: 16;
            };
          }
        }

        // Spotlight carousel.
        Box {
          orientation: vertical;
          spacing: 10;

          Overlay {
            child: Adw.Carousel spotlight_carousel {
              allow-scroll-wheel: false;
              spacing: 16;
            };

            [overlay]
            Button {
              styles [
                "circular",
                "osd",
              ]

              icon-name: "go-previous-symbolic";
              tooltip-text: _("Previous");
              halign: start;
              valign: center;
              margin-start: 12;
              clicked => $on_previous_spotlight() swapped;
            }

            [overlay]
            Button {
              styles [
                "circular",
                "osd",
              ]

              icon-name: "go-next-symbolic";
              tooltip-text: _("Next");
              halign: end;
              valign: center;
              margin-end: 12;
              clicked => $on_next_spotlight() swapped;
            }
          }

          Adw.CarouselIndicatorDots {
            carousel: spotlight_carousel;
          }
        }

        // What's new this month: recent releases, read live from each project.
        Box {
          orientation: vertical;
          spacing: 16;

          Box {
            spacing: 12;

            Box {
              orientation: vertical;
              spacing: 4;
              hexpand: true;

              Label {
                styles [
                  "title-2",
                ]

                label: _("What's New This Month");
                xalign: 0;
              }

              Label {
                styles [
                  "dim-label",
                ]

                label: _("Releases from the last 31 days, read live from each project.");
                xalign: 0;
                wrap: true;
              }
            }

            Adw.Spinner news_spinner {
              valign: center;
            }
          }

          FlowBox news_flowbox {
            selection-mode: none;
            homogeneous: true;
            min-children-per-line: 1;
            max-children-per-line: 4;
            column-spacing: 12;
            row-spacing: 12;
          }

          Label news_status_label {
            styles [
              "dim-label",
            ]

            xalign: 0;
            wrap: true;
            visible: false;
          }
        }

        // Hall of fame.
        Box hall_of_fame_section {
          orientation: vertical;
          spacing: 16;

          Box {
            spacing: 12;

            Box {
              orientation: vertical;
              spacing: 4;
              hexpand: true;

              Label {
                styles [
                  "title-2",
                ]

                label: _("Hall of Fame");
                xalign: 0;
              }

              Label {
                styles [
                  "dim-label",
                ]

                label: _("Winners of Hyprland's ricing contests.");
                xalign: 0;
                wrap: true;
              }
            }

            Button hall_of_fame_button {
              styles [
                "flat",
              ]

              label: _("See All");
              tooltip-text: _("Open Hyprland's Hall of Fame in your browser");
              valign: end;
            }
          }

          Grid wall_grid {
            column-spacing: 12;
            row-spacing: 12;
            column-homogeneous: true;
          }
        }

        // Distros.
        Box {
          orientation: vertical;
          spacing: 16;

          Box {
            spacing: 12;

            Box {
              orientation: vertical;
              spacing: 4;
              hexpand: true;

              Label {
                styles [
                  "title-2",
                ]

                label: _("Distros");
                xalign: 0;
              }

              Label {
                styles [
                  "dim-label",
                ]

                label: _("A hand-picked few to start from. There are many more out there.");
                xalign: 0;
                wrap: true;
              }
            }

            Button {
              styles [
                "flat",
              ]

              label: _("See All");
              valign: end;
              action-name: "win.show-page";
              action-target: "'distros'";
            }
          }

          ScrolledWindow {
            hscrollbar-policy: external;
            vscrollbar-policy: never;
            propagate-natural-width: true;
            halign: start;

            // Filled from the distro families in code, the same on Explore and Distros.
            child: Adw.ToggleGroup family_toggles {
              styles [
                "round",
              ]
            };
          }

          FlowBox distros_flowbox {
            selection-mode: none;
            homogeneous: true;
            min-children-per-line: 1;
            max-children-per-line: 4;
            column-spacing: 12;
            row-spacing: 12;
          }
        }

        // Desktops.
        Box {
          orientation: vertical;
          spacing: 16;

          Box {
            spacing: 12;

            Box {
              orientation: vertical;
              spacing: 4;
              hexpand: true;

              Label {
                styles [
                  "title-2",
                ]

                label: _("Desktops");
                xalign: 0;
              }

              Label {
                styles [
                  "dim-label",
                ]

                label: _("A full desktop: compositor, shell, settings and apps together.");
                xalign: 0;
                wrap: true;
              }
            }

            Button {
              styles [
                "flat",
              ]

              label: _("See All");
              valign: end;
              action-name: "win.show-page";
              action-target: "'desktops'";
            }
          }

          FlowBox desktops_flowbox {
            selection-mode: none;
            homogeneous: true;
            min-children-per-line: 1;
            max-children-per-line: 4;
            column-spacing: 12;
            row-spacing: 12;
          }
        }

        // Compositors.
        Box {
          orientation: vertical;
          spacing: 16;

          Box {
            spacing: 12;

            Box {
              orientation: vertical;
              spacing: 4;
              hexpand: true;

              Label {
                styles [
                  "title-2",
                ]

                label: _("Compositors");
                xalign: 0;
              }

              Label {
                styles [
                  "dim-label",
                ]

                label: _("Tiling, scrolling or stacking. Pick how your windows behave.");
                xalign: 0;
                wrap: true;
              }
            }

            Button {
              styles [
                "flat",
              ]

              label: _("See All");
              valign: end;
              action-name: "win.show-page";
              action-target: "'compositors'";
            }
          }

          FlowBox compositors_flowbox {
            selection-mode: none;
            homogeneous: true;
            min-children-per-line: 1;
            max-children-per-line: 4;
            column-spacing: 12;
            row-spacing: 12;
          }
        }

        // Your system.
        Box {
          styles [
            "system-teaser",
          ]

          spacing: 24;

          Box {
            orientation: vertical;
            spacing: 8;
            hexpand: true;
            valign: center;

            Label {
              styles [
                "kicker",
              ]

              label: _("Your system");
              xalign: 0;
            }

            Label system_title_label {
              styles [
                "title-1",
              ]

              xalign: 0;
              wrap: true;
            }

            Label {
              label: _("See which ideas are ready on your system, and how to build the rest.");
              xalign: 0;
              wrap: true;
            }
          }

          Button {
            styles [
              "pill",
            ]

            label: _("Open Your System");
            valign: center;
            action-name: "win.show-page";
            action-target: "'system'";
          }
        }
      };
    };
  };
}
