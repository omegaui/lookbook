using Gtk 4.0;
using Adw 1;

template $ProtocolCard: Adw.Bin {
  styles [
    "card",
    "protocol-card",
  ]

  child: Box {
    spacing: 16;

    $IconTile art {
      valign: center;
    }

    Box {
      orientation: vertical;
      spacing: 4;
      valign: center;
      hexpand: true;

      Box {
        spacing: 8;

        Label name_label {
          styles [
            "heading",
          ]

          xalign: 0;
          wrap: true;
          max-width-chars: 22;
        }

        // A button, so keyboard and screen reader users can reach the reason too.
        MenuButton hidden_label {
          styles [
            "badge",
            "elsewhere",
            "badge-button",
          ]

          tooltip-text: _("Why is it hidden?");
          valign: center;
          visible: false;

          child: Label {
            label: _("Hidden in Flatpak");
          };

          popover: Popover {
            child: Label {
              label: _("The compositor hides this protocol from sandboxed apps, so Syspedia cannot see it. Programs outside the sandbox can.");
              wrap: true;
              max-width-chars: 36;
              margin-start: 6;
              margin-end: 6;
              margin-top: 6;
              margin-bottom: 6;
            };
          };
        }
      }

      Label interface_label {
        styles [
          "caption",
          "dim-label",
          "monospace",
        ]

        xalign: 0;
        ellipsize: end;
        max-width-chars: 30;
      }

      Label description_label {
        xalign: 0;
        wrap: true;
        max-width-chars: 34;
        margin-top: 4;
      }

      Box {
        spacing: 6;
        margin-top: 4;

        Label {
          styles [
            "caption-heading",
            "useful-for",
          ]

          label: _("Useful for");
          valign: start;
        }

        Label useful_for_label {
          styles [
            "caption",
          ]

          xalign: 0;
          wrap: true;
          max-width-chars: 30;
          hexpand: true;
        }
      }
    }
  };
}
