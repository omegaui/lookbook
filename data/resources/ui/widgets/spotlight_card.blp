using Gtk 4.0;

template $SpotlightCard: Box {
  styles [
    "spotlight",
  ]

  homogeneous: false;
  overflow: hidden;
  height-request: 340;
  hexpand: true;

  Box {
    orientation: vertical;
    spacing: 14;
    valign: center;
    margin-top: 40;
    margin-bottom: 40;
    margin-start: 72;
    margin-end: 16;

    Box {
      spacing: 16;

      $LogoTile tile {
        valign: center;
      }

      Box {
        orientation: vertical;
        spacing: 2;
        valign: center;

        Label kicker_label {
          styles [
            "kicker",
          ]

          xalign: 0;
        }

        Label name_label {
          styles [
            "title-1",
          ]

          xalign: 0;
          wrap: true;
        }
      }
    }

    Label tagline_label {
      xalign: 0;
      wrap: true;
      max-width-chars: 44;
    }

    Box chips_box {
      spacing: 6;
    }

    Box {
      spacing: 10;
      margin-top: 6;

      Button details_button {
        styles [
          "pill",
          "suggested-action",
        ]

        label: _("View Details");
        action-name: "win.show-item";
      }

      Button run_button {
        styles [
          "pill",
        ]

        label: _("Can I Run It?");
        action-name: "win.can-i-run";
      }
    }
  }

  // A drawn desktop, laid out the way the featured item arranges windows,
  // until the item's real screenshot arrives in the same place.
  Stack art_stack {
    transition-type: crossfade;
    hexpand: true;

    StackPage {
      name: "drawing";

      child: $DesktopScene scene {};
    }

    StackPage {
      name: "screenshot";

      child: $EdgePicture picture {};
    }
  }
}
