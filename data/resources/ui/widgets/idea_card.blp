using Gtk 4.0;
using Adw 1;

template $IdeaCard: Adw.Bin {
  styles [
    "card",
    "idea-card",
  ]

  child: Box {
    spacing: 14;

    $LogoTile tile {
      valign: start;
    }

    Box {
      orientation: vertical;
      spacing: 6;
      hexpand: true;

      Box {
        spacing: 8;

        Label name_label {
          styles [
            "heading",
          ]

          xalign: 0;
          wrap: true;
        }

        Label status_label {
          styles [
            "badge",
          ]

          valign: center;
        }
      }

      Label description_label {
        styles [
          "dim-label",
        ]

        xalign: 0;
        wrap: true;
      }

      Box {
        spacing: 6;

        Label route_label {
          styles [
            "chip",
          ]

          wrap: true;
        }

        Label interface_label {
          styles [
            "protocol-chip",
          ]

          visible: false;
          ellipsize: end;
        }
      }

      Label places_label {
        styles [
          "caption",
          "dim-label",
        ]

        xalign: 0;
        wrap: true;
        visible: false;
      }
    }
  };
}
