using Gtk 4.0;

template $ScreenshotCard: Button {
  styles [
    "flat",
    "screenshot-card",
  ]

  clicked => $on_clicked() swapped;

  child: Box {
    orientation: vertical;
    spacing: 8;

    Overlay {
      vexpand: true;

      $ScreenshotPicture picture {
        vexpand: true;
      }

      [overlay]
      Label place_label {
        styles [
          "place-pill",
        ]

        halign: start;
        valign: start;
        margin-start: 10;
        margin-top: 10;
      }
    }

    Box {
      spacing: 8;

      Label title_label {
        styles [
          "caption-heading",
        ]

        xalign: 0;
        hexpand: true;
        ellipsize: end;
      }

      Label author_label {
        styles [
          "caption",
          "dim-label",
        ]

        ellipsize: end;
      }
    }
  };
}
