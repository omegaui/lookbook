using Gtk 4.0;

template $ScreenshotCard: Box {
  orientation: vertical;
  spacing: 8;

  $ScreenshotMock mock {
    vexpand: true;
  }

  Box {
    spacing: 8;

    Label title_label {
      styles [
        "caption-heading",
      ]

      xalign: 0;
      hexpand: true;
      ellipsize: end;
    }

    Label author_label {
      styles [
        "caption",
        "dim-label",
      ]

      ellipsize: end;
    }
  }
}
