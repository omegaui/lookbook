using Gtk 4.0;
using Adw 1;

template $CatalogCard: Adw.Bin {
  styles [
    "card",
    "catalog-card",
  ]

  child: Box {
    spacing: 16;

    $LogoTile tile {
      valign: center;
    }

    Box {
      orientation: vertical;
      spacing: 4;
      valign: center;
      hexpand: true;

      Box {
        spacing: 8;

        Label name_label {
          styles [
            "heading",
          ]

          xalign: 0;
          ellipsize: end;
        }

        Label badge_label {
          styles [
            "badge",
          ]

          visible: false;
          valign: center;
        }
      }

      Label description_label {
        styles [
          "dim-label",
        ]

        xalign: 0;
        wrap: true;
        wrap-mode: word_char;
        lines: 2;
        ellipsize: end;
        max-width-chars: 32;
      }

      Box chips_box {
        spacing: 6;
        margin-top: 2;
      }

      Box checks_box {
        spacing: 12;
        margin-top: 4;
        visible: false;
      }
    }
  };
}
