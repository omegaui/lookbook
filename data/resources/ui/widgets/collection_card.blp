using Gtk 4.0;

// A button: it opens the page that lists what the collection holds.
template $CollectionCard: Button {
  styles [
    "collection-card",
  ]

  width-request: 210;
  height-request: 290;
  action-name: "win.show-page";

  child: Box {
  orientation: vertical;
  spacing: 12;

  Label {
    styles [
      "collection-tag",
    ]

    label: _("Collection");
    halign: start;
  }

  Box tiles_box {
    spacing: 8;
    vexpand: true;
    valign: center;
  }

  Label title_label {
    styles [
      "collection-title",
    ]

    xalign: 0;
    wrap: true;
  }

  Label names_label {
    styles [
      "collection-names",
    ]

    xalign: 0;
    wrap: true;
  }
  };
}
