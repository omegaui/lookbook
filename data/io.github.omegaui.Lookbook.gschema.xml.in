<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="@gettext-package@">
  <schema id="@app-id@" path="/io/github/omegaui/Lookbook/">
    <key name="window-width" type="i">
      <default>1200</default>
      <summary>Window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>820</default>
      <summary>Window height</summary>
    </key>
    <key name="is-maximized" type="b">
      <default>false</default>
      <summary>Window maximized state</summary>
    </key>
    <key name="last-page" type="s">
      <default>"explore"</default>
      <summary>Last visible page</summary>
      <description>The page shown when the app starts: "explore", "distros", "desktops", "compositors", "wallpapers" or "system".</description>
    </key>
  </schema>
</schemalist>
