<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@app-id@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <!-- The code is GPL; bundled logos and Wayland protocol data carry their own licenses (see the About dialog). -->
  <project_license>GPL-3.0-or-later AND CC0-1.0 AND CC-BY-SA-2.5 AND CC-BY-SA-3.0 AND CC-BY-SA-4.0 AND CC-BY-4.0 AND Apache-2.0 AND MIT AND Unlicense</project_license>

  <name>@name@</name>
  <summary>Find a Linux desktop that fits you</summary>
  <description>
    <p>Lookbook is a friendly guide to the Linux desktop. Browse what people run, see how it looks, and find out what your own system can do. Nothing is sold or installed from it.</p>
    <ul>
      <li>Galleries of distributions, desktops and Wayland compositors, each with a page of real screenshots</li>
      <li>How Linux fits together: what a distribution, a desktop and a compositor each do</li>
      <li>The winners of Hyprland's ricing contests, and setups people share, with links to get them</li>
      <li>Wallpapers you can preview and set</li>
      <li>The latest releases of the month</li>
      <li>Your distribution, desktop, compositor and hardware, and what you can build on them</li>
      <li>Can I Run It? checks your hardware and your distribution's packages for any desktop or compositor</li>
    </ul>
  </description>

  <developer id="io.github.omegaui">
    <name translate="no">omegaui</name>
  </developer>

  <url type="homepage">https://github.com/omegaui/lookbook</url>
  <url type="bugtracker">https://github.com/omegaui/lookbook/issues</url>
  <url type="vcs-browser">https://github.com/omegaui/lookbook</url>

  <launchable type="desktop-id">@app-id@.desktop</launchable>
  <translation type="gettext">@gettext-package@</translation>
  <content_rating type="oars-1.1" />

  <requires>
    <display_length compare="ge">768</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>

  <branding>
    <color type="primary" scheme_preference="light">#a8c8f0</color>
    <color type="primary" scheme_preference="dark">#1c3554</color>
  </branding>

  <releases>
    <release version="0.1.0" date="2026-11-08">
      <description>
        <p>The first release of Lookbook, a guide to the Linux desktop.</p>
        <ul>
          <li>Explore collections, spotlights, this month's releases and the Hall of Fame</li>
          <li>Browse 16 distributions, 9 desktops and 9 Wayland compositors, each with screenshots, facts and similar picks</li>
          <li>See what your system runs and which ideas, like a status bar or a lock screen, you can build on it</li>
          <li>Ask Can I Run It? for any desktop or compositor</li>
          <li>Preview wallpapers from artists' collections and set them</li>
          <li>The catalog updates every day without app updates</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
